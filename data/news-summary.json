    {
      "id": "torsten-slok-2026-07-30",
      "person": "Torsten Slok",
      "person_id": "torsten-slok",
      "specialty": "金利・信用・成長",
      "article_date": "2026-07-30",
      "age_days": 18,
      "title": "インフレは高止まり、金利の長期高止まりが株式の重しに",
      "target": "マクロ",
      "period": "不明",
      "evaluation": 2,
      "stance": "short",
      "stance_label": "やや弱気",
      "body": "Torsten Slok氏は、インフレが依然として非常に高い水準で推移していると指摘した。加えて、AI投資、財政赤字、地政学的リスクが金利を長期間高止まりさせる可能性があると説明。高金利の長期化は株式市場にとって重しとなり、金融環境の改善を遅らせる要因になるとの見方を示した。",
      "points": [
