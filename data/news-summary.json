  "articles": [
    {
      "id": "christophe-barraud-2026-08-15",
      "person": "Christophe Barraud",
      "person_id": "christophe-barraud",
      "specialty": "短期マクロ・政策",
      "article_date": "2026-08-15",
      "age_days": 2,
      "title": "円買い介入の限界とドル円160台の再接近",
      "target": "マクロ",
      "period": "不明",
      "evaluation": 2,
      "stance": "short",
      "stance_label": "やや弱気",
      "body": "Christophe Barraudは、7月末の米国・日本による円支援後もUSD/JPYが2週間足らずで160近辺へ戻ったことから、為替介入だけでは円安の背景を変えられないと指摘した。日本の低金利を利用した円売り・高利回り資産投資が再開しやすく、背景が変わらなければ160〜162への再接近は十分あり得るとした。一方、日銀利上げ加速と米金利低下が重なれば金利差が縮み、円売りの巻き戻しで円高が急速に進むリスクを警戒した。",
      "points": [
        "7月末の円支援後もUSD/JPYは2週間足らずで160近辺へ戻り、介入単独の効果には限界があるとした。",
        "日本の低金利と米国などの高い利回りの差が続く限り、USD/JPYが160〜162へ戻る見通しはなお成り立つとした。",
        "日銀の利上げ加速と米金利低下で金利差が縮小すれば、円売り取引の解消が円高を増幅させるため、円売りの損益見合いは悪化していると分析した。"
      ],
      "source_type": "SNS",
      "source_class": "直接引用",
      "source_url": "https://x.com/C_Barraud/status/2088161306209661373",
      "no_result": false
    },
    {
      "id": "torsten-slok-2026-08-13",
      "person": "Torsten Slok",
      "person_id": "torsten-slok",
      "specialty": "金利・信用・成長",
      "article_date": "2026-08-13",
      "age_days": 4,
      "title": "AIが企業利益を圧迫する可能性を市場は過小評価",
      "target": "株式",
      "period": "長期",
      "evaluation": 2,
      "stance": "short",
      "stance_label": "やや弱気",
      "body": "Torsten Slokは、追跡する上場ソフトウェア・ホワイトカラーサービス企業200社超のうち、今後2年間に売上高とEBITDAの両方が減少すると予想される企業は10社にとどまると指摘した。市場はAIによる混乱の可能性を織り込み始めているものの、利益率や収益への影響を十分には織り込んでいない可能性がある。AIの直接代替、人員需要の減少、AIネイティブ企業による市場シェア獲得を主な圧力経路として挙げた。",
      "points": [
        "市場予想では、対象となる上場企業200社超のうち、今後2年間に売上高とEBITDAがともに減少する見通しの企業は10社だけである。",
        "AIの普及が進むと、同じ業務の低コスト代替、人員・契約者・利用者の減少、AIネイティブ企業の急速な革新という3経路で収益と利益率に圧力が及ぶ可能性がある。",
        "AIによる業績悪化の可能性が市場予想へ十分に反映されていないという見方であり、特にソフトウェアやホワイトカラーサービス関連株には中長期的にやや弱い材料である。"
      ],
      "source_type": "公式発表",
      "source_class": "直接引用",
      "source_url": "https://www.apollo.com/wealth/insights-news/insights/daily-spark/markets-may-still-be-underestimating-ai-disruption",
      "no_result": false
    },
    {
      "id": "jeffrey-degraaf-2026-08-13",
      "person": "Jeffrey deGraaf",
      "person_id": "jeffrey-degraaf",
      "specialty": "株式テクニカル・市場内部",
      "article_date": "2026-08-13",
      "age_days": 4,
      "title": "テック不安定化でヘルスケア株の相対優位を期待",
      "target": "株式",
      "period": "不明",
      "evaluation": 4,
      "stance": "long",
      "stance_label": "やや強気",
      "body": "Jeffrey deGraafは、テクノロジー株が不安定になる局面ではヘルスケアが恩恵を受けやすいと述べた。ヘルスケアは長期にわたり市場を下回ってきたが、バイオテクノロジーと製薬を先導役に相対的な値動きが改善し、ライフサイエンスやサービス関連にも広がり始めているという。20日高値を更新する銘柄の増加が続けば、買いの広がりを確認できるとしている。",
      "points": [
        "ヘルスケアは長期の出遅れから、対市場での値動き改善が始まっている。",
        "テック株の混乱は、ヘルスケアへ資金が向かう追い風になり得る。",
        "バイオテクノロジーと製薬が先導し、20日高値更新銘柄の増加が続くかを重視している。"
      ],
      "source_type": "報道記事",
